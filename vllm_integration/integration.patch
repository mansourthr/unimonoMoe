+        pool.pads_ptr,
+        pool.seqctr_ptr,
+        plan.rank,
+        plan.world,
+        chunks,
+        plan.ncomm,
+        residual if plan.fold_shared else None,
+        float(out_scale) if plan.fold_shared else 1.0,
+    )
+    return out
