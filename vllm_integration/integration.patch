diff --git a/vllm/_custom_ops.py b/vllm/_custom_ops.py
index 5d63ffa..0fc33f9 100644
--- a/vllm/_custom_ops.py
+++ b/vllm/_custom_ops.py
@@ -4237,3 +4237,758 @@ if hasattr(torch.ops._C, "minimax_allreduce_rms_qk"):
             torch.empty([token_num, q_size], dtype=qkv.dtype, device=qkv.device),
             torch.empty([token_num, kv_size], dtype=qkv.dtype, device=qkv.device),
         )
+
+
+# Prefill MoE monokernel: a standalone .so launched via ctypes. The kernel
+# does its own softmax top-k routing and counting-sort, fuses
+# up -> SiLU -> down in a single persistent launch, and consumes the raw
+# block-wise FP8 weights. It refuses to launch above
+# MOE_MONOKERNEL_PREFILL_MAX_TOKENS.
+MOE_MONOKERNEL_PREFILL_MAX_TOKENS = 30720
+_prefill_monokernel_lib = None
+# ids of loaded libraries that export the bias-carrying entry point
+_prefill_monokernel_has_router: set[int] = set()
+
+
+def _load_prefill_monokernel():
+    global _prefill_monokernel_lib
+    if _prefill_monokernel_lib is None:
+        import ctypes
+        import os
+
+        # The binary must be named explicitly. A default path would make "unset"
+        # mean "load whichever build sits there" rather than "no kernel", and a
+        # build is not guaranteed to export the width symbols (n_up, n_half): a
+        # symbol the geometry gate cannot read is skipped rather than treated as
+        # a mismatch, so an unset variable could enable a kernel compiled for a
+        # different intermediate width and index the weights at the wrong
+        # stride. A caller that wants the kernel off sets
+        # VLLM_USE_MOE_MONOKERNEL=0.
+        if not os.environ.get("VLLM_PREFILL_MONOKERNEL_SO"):
+            raise RuntimeError(
+                "VLLM_PREFILL_MONOKERNEL_SO is not set, so no monokernel "
+                "binary has been selected; the compiled geometry of the kernel "
+                "has to be the caller's explicit choice"
+            )
+
+        lib = ctypes.CDLL(envs.VLLM_PREFILL_MONOKERNEL_SO)
+        lib.launch_prefill_moe_wgmma_q1.restype = ctypes.c_int
+        lib.prefill_wgmma_workspace_bytes.restype = ctypes.c_size_t
+        # The bias-carrying entry point is optional. A .so built before the
+        # router work does not export it, and a model whose router has no
+        # correction bias never needs it, so absence is recorded instead of
+        # raising and every existing binary keeps working unchanged.
+        try:
+            lib.launch_prefill_moe_wgmma_q1_router.restype = ctypes.c_int
+            _prefill_monokernel_has_router.add(id(lib))
+        except AttributeError:
+            pass
+        _bind_prefill_monokernel_tp(lib)
+        _prefill_monokernel_lib = lib
+    return _prefill_monokernel_lib
+
+
+# Fused tensor-parallel capability, read off the binary rather than assumed.
+# Each of these answers a question the caller cannot answer for itself: the
+# widest chunk count the binary's pad layout was compiled for, the shard
+# alignment its reduce depends on, the multimem vector width, whether the launch
+# takes the persistent device sequence counter, and the grid the kernel was
+# built for. A .so from before the TP work exports none of them and is recorded
+# as not TP-capable, which is the same answer as an explicit refusal and does
+# not break any existing caller.
+_TP_CAP_SYMBOLS = (
+    "tp_max_c",
+    "tp_has_residual",
+    "tp_align",
+    "tp_mm",
+    "tp_has_devseq",
+    "tp_seq_bytes",
+    "grid_size",
+)
+_prefill_monokernel_tp: dict[int, dict] = {}
+
+
+def _bind_prefill_monokernel_tp(lib) -> None:
+    import ctypes
+
+    caps: dict = {}
+    try:
+        lib.launch_prefill_moe_wgmma_q1_tp.restype = ctypes.c_int
+        caps["has_tp"] = True
+    except AttributeError:
+        caps["has_tp"] = False
+    # The residual entry point is a SEPARATE symbol rather than two extra
+    # arguments on the old one, because the stream pointer is the last argument:
+    # widening _tp in place would make an older binary read the residual pointer
+    # as its stream. Both the symbol and the integer capability below have to be
+    # present, so a partially updated binary is refused rather than half used.
+    try:
+        lib.launch_prefill_moe_wgmma_q1_tp2.restype = ctypes.c_int
+        caps["has_tp2_entry"] = True
+    except AttributeError:
+        caps["has_tp2_entry"] = False
+    for name in _TP_CAP_SYMBOLS:
+        try:
+            fn = getattr(lib, "prefill_wgmma_" + name)
+        except AttributeError:
+            caps[name] = None
+            continue
+        fn.restype = ctypes.c_int
+        caps[name] = fn()
+    # The pad window size is a FUNCTION of the configuration, so the function is
+    # kept rather than one of its values. A caller that recomputes the formula
+    # becomes a second source of truth and the two drift the moment the kernel's
+    # pad layout changes.
+    try:
+        fn = lib.prefill_wgmma_tp_pad_words
+        fn.restype = ctypes.c_int
+        fn.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int]
+        caps["pad_words_fn"] = fn
+    except AttributeError:
+        caps["pad_words_fn"] = None
+    _prefill_monokernel_tp[id(lib)] = caps
+
+
+def prefill_monokernel_tp_caps() -> dict:
+    """Fused-TP capability of the loaded binary.
+
+    ``usable`` False means this .so cannot drive the fused collective and every
+    caller must take the ordinary path. It is deliberately the conjunction of
+    everything the fused path dereferences, so a partially updated binary is
+    refused as a whole rather than failing at the launch.
+    """
+    lib = _load_prefill_monokernel()
+    raw = _prefill_monokernel_tp[id(lib)]
+    caps = {k: v for k, v in raw.items() if k != "pad_words_fn"}
+    # Reported separately from usable: a binary that cannot fold still runs the
+    # routed-only epilogue, so this narrows what the fused path does rather than
+    # whether it runs at all.
+    caps["has_tp_residual"] = bool(
+        raw.get("has_tp2_entry") and raw.get("tp_has_residual")
+    )
+    caps["usable"] = bool(
+        raw.get("has_tp")
+        and raw.get("pad_words_fn") is not None
+        and raw.get("tp_max_c")
+        and raw.get("tp_align")
+        and raw.get("grid_size")
+    )
+    return caps
+
+
+def prefill_monokernel_tp_pad_words(nchunk: int, ncomm: int, world: int) -> int:
+    """Barrier pad words the loaded binary needs for this configuration."""
+    lib = _load_prefill_monokernel()
+    fn = _prefill_monokernel_tp[id(lib)].get("pad_words_fn")
+    if fn is None:
+        raise RuntimeError(
+            "loaded monokernel .so does not export prefill_wgmma_tp_pad_words, "
+            "so it cannot drive the fused TP path"
+        )
+    return int(fn(int(nchunk), int(ncomm), int(world)))
+
+
+# Expert geometry is baked into the .so at compile time, so a caller that
+# assumes it cannot notice a mismatch: the kernel would read the wrong bytes of
+# a differently shaped weight tensor and still return 0. Reading the constants
+# back off the binary turns a silent wrong answer into a check. Symbols an
+# older binary lacks are reported as None rather than guessed at.
+_MONOKERNEL_GEOMETRY_SYMBOLS = (
+    "num_experts",
+    # How many expert weight matrices the binary indexes, as opposed to how many
+    # the router scores. The two differ only under expert parallelism, and a
+    # binary that cannot report the local count has no EP path: its weight
+    # indexing is compiled against the global count. Reading it is what lets the
+    # caller tell a genuine EP build apart from a TP build pointed at EP-shaped
+    # weights, which is a wrong-stride read that still returns rc=0.
+    "num_experts_local",
+    # 1 when launch_prefill_moe_wgmma_q1_ep exists and every weight index, TMA
+    # extent and tile owner inside the kernel is a local expert id.
+    "ep_capable",
+    "top_k",
+    "k_dim",
+    "h_dim",
+    "n_up",
+    "n_half",
+    "router_mode",
+    "max_tiles",
+    "grid_size",
+    "fused_renorm",
+)
+
+
+_prefill_fused_renorm_cache: dict = {}
+
+
+def _prefill_fused_renorm(lib) -> bool:
+    """True when the loaded monokernel applies the router renorm itself.
+
+    Cached because this sits on the per-layer path. A binary without the symbol
+    answers False, which is the pre-fusion behaviour.
+    """
+    import ctypes
+
+    key = id(lib)
+    if key not in _prefill_fused_renorm_cache:
+        try:
+            fn = lib.prefill_wgmma_fused_renorm
+        except AttributeError:
+            _prefill_fused_renorm_cache[key] = False
+        else:
+            fn.restype = ctypes.c_int
+            _prefill_fused_renorm_cache[key] = bool(fn())
+    return _prefill_fused_renorm_cache[key]
+
+
+def prefill_monokernel_geometry() -> dict:
+    """Return the expert geometry the loaded monokernel .so was built for."""
+    import ctypes
+
+    lib = _load_prefill_monokernel()
+    geo = {}
+    for name in _MONOKERNEL_GEOMETRY_SYMBOLS:
+        try:
+            fn = getattr(lib, "prefill_wgmma_" + name)
+        except AttributeError:
+            geo[name] = None
+            continue
+        fn.restype = ctypes.c_int
+        geo[name] = int(fn())
+    geo["has_router_entry"] = id(lib) in _prefill_monokernel_has_router
+    return geo
+
+
+def monokernel_validate(
+    activations_in: torch.Tensor,
+    expert_weights_up: torch.Tensor,
+    expert_weights_down: torch.Tensor,
+    top_k: int,
+    e_score_correction_bias: torch.Tensor | None,
+    expert_map: torch.Tensor | None = None,
+) -> torch.Tensor | None:
+    """Check the loaded .so against these weights and return the bias to use.
+
+    Called by moe_monokernel_prefill and by the caller-side wrapper fix, which
+    replaces that function's body. Both go through here so the two cannot
+    disagree about which launches are legal.
+
+    Every field is compared because the kernel indexes its weights from
+    compile-time constants: a shape it was not built for is read at the wrong
+    stride and still returns rc=0, so an unchecked mismatch is a wrong answer
+    rather than a failure. Symbols an older binary does not export come back
+    None and are skipped rather than guessed at.
+    """
+    geo = prefill_monokernel_geometry()
+    n_up_built, n_half_built = geo.get("n_up"), geo.get("n_half")
+    w13_n, w2_n = expert_weights_up.size(1), expert_weights_down.size(2)
+    if n_up_built is not None and n_up_built != w13_n:
+        raise RuntimeError(
+            f"monokernel built for N_UP={n_up_built} but w13 has {w13_n}"
+        )
+    if n_half_built is not None and n_half_built != w2_n:
+        raise RuntimeError(
+            f"monokernel built for N_HALF={n_half_built} but w2 has {w2_n}"
+        )
+    if geo.get("k_dim") not in (None, activations_in.size(1)):
+        raise RuntimeError(
+            f"monokernel built for K_DIM={geo['k_dim']} but activations have "
+            f"{activations_in.size(1)}"
+        )
+    # EXPERT COUNTS. There are two of them and they are checked separately,
+    # because under expert parallelism the router scores every global expert
+    # while only this rank's slabs exist locally. num_experts is the routing
+    # width; num_experts_local is the number of weight slabs the kernel indexes.
+    # A binary that does not export the local count has no EP path at all, so
+    # the local count IS the global count there and an EP-shaped weight tensor
+    # has to be refused rather than read at the wrong stride.
+    n_e_built = geo.get("num_experts")
+    n_local_built = geo.get("num_experts_local")
+    if n_local_built is None:
+        n_local_built = n_e_built
+    n_local_got = expert_weights_up.size(0)
+    if n_local_built is not None and n_local_built != n_local_got:
+        raise RuntimeError(
+            f"monokernel built to index {n_local_built} local expert slabs but "
+            f"got {n_local_got}"
+        )
+    if expert_map is None:
+        # No map means every routed expert must be local, which is only true when
+        # the two counts coincide.
+        if n_e_built is not None and n_e_built != n_local_got:
+            raise RuntimeError(
+                f"monokernel built for E={n_e_built} but got {n_local_got} "
+                "experts and no expert_map to remap them"
+            )
+    else:
+        if not bool(geo.get("ep_capable")):
+            raise RuntimeError(
+                "an expert_map was supplied but the loaded monokernel .so is "
+                "not EP capable (no launch_prefill_moe_wgmma_q1_ep); its weight "
+                "indexing would use global expert ids"
+            )
+        if expert_map.dtype != torch.int32:
+            raise RuntimeError(f"expert_map must be int32, got {expert_map.dtype}")
+        if n_e_built is not None and expert_map.numel() != n_e_built:
+            raise RuntimeError(
+                f"monokernel built for E={n_e_built} but expert_map has "
+                f"{expert_map.numel()} entries"
+            )
+    if geo.get("top_k") not in (None, int(top_k)):
+        raise RuntimeError(
+            f"monokernel built for TOP_K={geo['top_k']} but got top_k={top_k}"
+        )
+
+    # A correction bias only means anything to a sigmoid build. Silently
+    # dropping it would produce a plausible number from the wrong experts.
+    bias = e_score_correction_bias
+    if bias is not None:
+        if geo.get("router_mode") == 0:
+            raise RuntimeError(
+                "monokernel .so is a softmax (ROUTER_MODE 0) build and cannot "
+                "apply an e_score_correction_bias"
+            )
+        if not geo.get("has_router_entry"):
+            raise RuntimeError(
+                "monokernel .so does not export "
+                "launch_prefill_moe_wgmma_q1_router, so a correction bias "
+                "cannot be passed"
+            )
+        return bias.float().contiguous()
+
+    if geo.get("router_mode") not in (None, 0):
+        # The reverse mistake: a sigmoid build reached with no bias would score
+        # every expert unbiased, which is not the model's routing either.
+        raise RuntimeError(
+            f"monokernel .so is a ROUTER_MODE {geo['router_mode']} (sigmoid) "
+            "build but no e_score_correction_bias was supplied"
+        )
+    return None
+
+
+def _moe_monokernel_prefill_impl(
+    activations_in: torch.Tensor,
+    router_logits: torch.Tensor,
+    expert_weights_up: torch.Tensor,
+    expert_scales_up: torch.Tensor,
+    expert_weights_down: torch.Tensor,
+    expert_scales_down: torch.Tensor,
+    top_k: int,
+    renormalize: bool,
+    e_score_correction_bias: torch.Tensor | None,
+    out: torch.Tensor,
+    tp: tuple | None = None,
+    # The shared-expert half, folded into the epilogue so the single fused
+    # collective carries out_scale*routed + residual instead of the routed half
+    # alone. Null means the shipped store, and out_scale 1.0f is exact in fp32,
+    # so an unfolded call is bit for bit what it was.
+    residual: torch.Tensor | None = None,
+    out_scale: float = 1.0,
+    # EXPERT PARALLELISM. vLLM's own expert_map, int32 [global_num_experts]:
+    # entry g is the local slot of global expert g on this rank, or -1 when that
+    # expert lives on another rank. Passing it selects the EP entry point, where
+    # the kernel remaps every routed slot once during routing and generates no
+    # local work for an unowned one. The result is a PARTIAL sum over this
+    # rank's experts, which is what the caller's own all-reduce expects.
+    expert_map: torch.Tensor | None = None,
+) -> None:
+    """Prefill MoE monokernel for block-wise FP8 experts.
+
+    The kernel routes internally, so the scoring function is a property of the
+    binary rather than of this call: a ROUTER_MODE 0 build takes softmax over
+    the logits, and a mode 1 or 2 build takes sigmoid scores with the optional
+    per-expert correction bias added for SELECTION ONLY, the weight staying the
+    unbiased score. Passing a bias to a mode 0 build would therefore be
+    silently ignored, so it is refused instead.
+
+    Router weights are returned unnormalized; when renormalize is set the top-k
+    weights are divided by their per-token sum, which is exact algebra on the
+    weighted output.
+    """
+    import ctypes
+
+    lib = _load_prefill_monokernel()
+
+    M, K = activations_in.shape
+    H = expert_weights_down.size(1)
+    top_k = int(top_k)
+    n_kblk = K // 128
+    device = activations_in.device
+
+    act = activations_in.contiguous()
+    logits = router_logits.float().contiguous()
+    w_up = expert_weights_up.contiguous().view(torch.uint8)
+    w_down = expert_weights_down.contiguous().view(torch.uint8)
+    s_up = expert_scales_up.float().contiguous()
+    s_down = expert_scales_down.float().contiguous()
+
+    emap = None
+    if expert_map is not None:
+        if tp is not None:
+            # EP and the fused TP collective are mutually exclusive in vLLM's own
+            # parallel config (EP sets the MoE tp_size to 1), so a call that asks
+            # for both is a caller bug, not a configuration to accommodate.
+            raise RuntimeError(
+                "the fused TP collective and an expert_map cannot be combined; "
+                "an EP rank's output is reduced by the caller"
+            )
+        emap = expert_map.to(torch.int32).contiguous()
+
+    bias = monokernel_validate(
+        activations_in,
+        expert_weights_up,
+        expert_weights_down,
+        top_k,
+        e_score_correction_bias,
+        emap,
+    )
+
+    ws_bytes = lib.prefill_wgmma_workspace_bytes()
+    workspace = torch.zeros(ws_bytes, dtype=torch.uint8, device=device)
+    act_fp8 = torch.empty(M, K, dtype=torch.uint8, device=device)
+    act_scales = torch.empty(M, n_kblk, dtype=torch.float32, device=device)
+    topk_ids = torch.empty(M, top_k, dtype=torch.int32, device=device)
+    topk_weights = torch.empty(M, top_k, dtype=torch.float32, device=device)
+    sorted_ids = torch.empty(M * top_k, dtype=torch.int32, device=device)
+    output_accum = torch.empty(M * top_k, H, dtype=torch.float32, device=device)
+    if out.shape != (M, H) or out.dtype != torch.bfloat16:
+        raise RuntimeError(
+            f"monokernel destination must be [{M}, {H}] bfloat16, got "
+            f"{tuple(out.shape)} {out.dtype}"
+        )
+
+    stream = torch.cuda.current_stream().cuda_stream
+    # Same argument list either way; the router entry point takes one extra
+    # bias pointer just before the stream.
+    # The fused TP entry point takes the SAME 17 leading arguments and the same
+    # optional bias slot; everything the collective needs follows. It is used
+    # only when the caller supplies a fused configuration, so a caller that
+    # passes none gets byte-identical behaviour to before this change.
+    resid_ptr = 0
+    if residual is not None:
+        if residual.shape != (M, H) or residual.dtype != torch.bfloat16:
+            raise RuntimeError(
+                f"monokernel folded residual must be [{M}, {H}] bfloat16, got "
+                f"{tuple(residual.shape)} {residual.dtype}"
+            )
+        if not residual.is_contiguous():
+            raise RuntimeError("monokernel folded residual must be contiguous")
+        if tp is None:
+            raise RuntimeError(
+                "a folded residual is only carried by the fused collective; "
+                "without a TP configuration there is nothing to fold it into"
+            )
+        resid_ptr = residual.data_ptr()
+    fold = resid_ptr != 0 or float(out_scale) != 1.0
+    if fold and not _prefill_monokernel_tp[id(lib)].get("has_tp2_entry"):
+        raise RuntimeError(
+            "loaded monokernel .so has no launch_prefill_moe_wgmma_q1_tp2, so "
+            "it cannot fold a residual or apply an output scale"
+        )
+    if tp is not None:
+        entry = (
+            lib.launch_prefill_moe_wgmma_q1_tp2
+            if fold
+            else lib.launch_prefill_moe_wgmma_q1_tp
+        )
+    elif emap is not None:
+        # The EP entry point takes the bias slot unconditionally, then the map.
+        # It is a distinct symbol rather than a flag on an existing one, so a
+        # binary without an EP path raises AttributeError here instead of being
+        # handed a pointer it would ignore.
+        entry = lib.launch_prefill_moe_wgmma_q1_ep
+    else:
+        entry = (
+            lib.launch_prefill_moe_wgmma_q1_router
+            if bias is not None
+            else lib.launch_prefill_moe_wgmma_q1
+        )
+    rc = entry(
+        ctypes.c_void_p(logits.data_ptr()),
+        ctypes.c_int(M),
+        ctypes.c_int(64),
+        ctypes.c_void_p(workspace.data_ptr()),
+        ctypes.c_size_t(ws_bytes),
+        ctypes.c_void_p(act.data_ptr()),
+        ctypes.c_void_p(act_fp8.data_ptr()),
+        ctypes.c_void_p(act_scales.data_ptr()),
+        ctypes.c_void_p(w_up.data_ptr()),
+        ctypes.c_void_p(s_up.data_ptr()),
+        ctypes.c_void_p(w_down.data_ptr()),
+        ctypes.c_void_p(s_down.data_ptr()),
+        ctypes.c_void_p(output_accum.data_ptr()),
+        ctypes.c_void_p(topk_ids.data_ptr()),
+        ctypes.c_void_p(topk_weights.data_ptr()),
+        ctypes.c_void_p(sorted_ids.data_ptr()),
+        ctypes.c_void_p(out.data_ptr()),
+        *(
+            # The fused and EP entry points take the bias slot unconditionally,
+            # so a bias-free model passes an explicit null rather than omitting
+            # it.
+            (ctypes.c_void_p(bias.data_ptr() if bias is not None else 0),)
+            if tp is not None or emap is not None
+            else (ctypes.c_void_p(bias.data_ptr()),)
+            if bias is not None
+            else ()
+        ),
+        *(
+            _tp2_launch_args(tp, resid_ptr, out_scale)
+            if tp is not None and fold
+            else _tp_launch_args(tp)
+            if tp is not None
+            else (ctypes.c_void_p(emap.data_ptr()),)
+            if emap is not None
+            else ()
+        ),
+        ctypes.c_void_p(stream),
+    )
+    if rc != 0:
+        raise RuntimeError(f"launch_prefill_moe_wgmma_q1 failed: rc={rc}")
+
+    # Who owns the router renormalization is a property of the BINARY, not of
+    # this call. A fused build has already divided each row inside Phase 3, in
+    # fp32 before the single round to bf16; dividing again here would scale
+    # every row twice and produce a quietly wrong answer rather than a crash.
+    fused = _prefill_fused_renorm(lib)
+    if renormalize and not fused:
+        denom = topk_weights.sum(1, keepdim=True).clamp(min=1e-30)
+        out.div_(denom.to(out.dtype))
+    elif fused and not renormalize:
+        # The normalization is baked into the binary and cannot be undone from
+        # here, so returning normalized rows for an unnormalized request would
+        # be an invisible wrong answer. Refuse instead.
+        raise RuntimeError(
+            "monokernel .so is a FUSED_RENORM build but renormalize=False was "
+            "requested; the in-kernel normalization cannot be undone"
+        )
+
+
+def _tp2_launch_args(tp: tuple, residual_ptr: int, out_scale: float) -> tuple:
+    """The residual entry point's arguments, in the order it takes them.
+
+    tp is (mc_ptr, pads_ptr, seqctr_ptr, rank, world, nchunk, ncomm).
+
+    Unlike _tp_launch_args this ALWAYS emits the sequence-counter slot, even
+    when it is null. There it was optional because it was the last argument
+    before the stream; here two arguments follow it, so omitting it would slide
+    the residual pointer into its place.
+    """
+    import ctypes
+
+    mc, pads, seqctr, rank, world, nchunk, ncomm = tp
+    return (
+        ctypes.c_void_p(int(mc)),
+        ctypes.c_void_p(int(pads)),
+        ctypes.c_int(int(rank)),
+        ctypes.c_int(int(world)),
+        ctypes.c_int(int(nchunk)),
+        ctypes.c_int(int(ncomm)),
+        ctypes.c_uint(0),
+        ctypes.c_void_p(int(seqctr)),
+        ctypes.c_void_p(int(residual_ptr)),
+        ctypes.c_float(float(out_scale)),
+    )
+
+
+def _tp_launch_args(tp: tuple) -> tuple:
+    """The fused collective's arguments, in the order the entry point takes them.
+
+    tp is (mc_ptr, pads_ptr, seqctr_ptr, rank, world, nchunk, ncomm).
+
+    The host sequence value is passed as 0 and superseded by the device counter
+    whenever the binary exports one: a host counter is baked into a CUDA graph
+    and replays the same value, which is the whole reason the device counter
+    exists. A binary without it keeps the old argument path and is refused for
+    graph use by the caller instead of being handed a value that cannot work.
+    """
+    import ctypes
+
+    mc, pads, seqctr, rank, world, nchunk, ncomm = tp
+    args = (
+        ctypes.c_void_p(int(mc)),
+        ctypes.c_void_p(int(pads)),
+        ctypes.c_int(int(rank)),
+        ctypes.c_int(int(world)),
+        ctypes.c_int(int(nchunk)),
+        ctypes.c_int(int(ncomm)),
+        ctypes.c_uint(0),
+    )
+    if seqctr:
+        args = args + (ctypes.c_void_p(int(seqctr)),)
+    return args
+
+
+def moe_monokernel_prefill(
+    activations_in: torch.Tensor,
+    router_logits: torch.Tensor,
+    expert_weights_up: torch.Tensor,
+    expert_scales_up: torch.Tensor,
+    expert_weights_down: torch.Tensor,
+    expert_scales_down: torch.Tensor,
+    top_k: int = 8,
+    renormalize: bool = True,
+    e_score_correction_bias: torch.Tensor | None = None,
+    expert_map: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Allocating variant. This one really does return a fresh tensor, so the
+    functional registration below is true of it.
+
+    expert_map is vLLM's own int32 global->local map, or None for the
+    tensor-parallel case where every expert is local. Under EP the returned
+    tensor is this rank's PARTIAL sum and the caller still owns the reduce.
+    """
+    M = activations_in.size(0)
+    H = expert_weights_down.size(1)
+    out = torch.empty(M, H, dtype=torch.bfloat16, device=activations_in.device)
+    _moe_monokernel_prefill_impl(
+        activations_in,
+        router_logits,
+        expert_weights_up,
+        expert_scales_up,
+        expert_weights_down,
+        expert_scales_down,
+        top_k,
+        renormalize,
+        e_score_correction_bias,
+        out,
+        None,
+        None,
+        1.0,
+        expert_map,
+    )
+    return out
+
+
+def moe_monokernel_prefill_out(
+    activations_in: torch.Tensor,
+    router_logits: torch.Tensor,
+    expert_weights_up: torch.Tensor,
+    expert_scales_up: torch.Tensor,
+    expert_weights_down: torch.Tensor,
+    expert_scales_down: torch.Tensor,
+    out: torch.Tensor,
+    top_k: int = 8,
+    renormalize: bool = True,
+    e_score_correction_bias: torch.Tensor | None = None,
+    tp_mc_ptr: int = 0,
+    tp_pads_ptr: int = 0,
+    tp_seqctr_ptr: int = 0,
+    tp_rank: int = 0,
+    tp_world: int = 1,
+    tp_nchunk: int = 0,
+    tp_ncomm: int = 0,
+    tp_residual: torch.Tensor | None = None,
+    tp_out_scale: float = 1.0,
+) -> None:
+    """Write the MoE result into a caller-supplied destination.
+
+    This is the variant the fused path uses, and it exists because that path's
+    destination is a persistent symmetric buffer rather than a fresh
+    allocation. Declaring the write (mutates_args=("out",)) is what makes
+    repeated calls on the same buffer ordered and non-eliminable; the functional
+    variant above would have claimed each call produced an independent tensor.
+
+    A non-zero tp_ncomm selects the fused collective, in which case out MUST be
+    the symmetric window that tp_mc_ptr aliases. Passing tp_ncomm == 0 runs the
+    ordinary kernel and leaves the reduction to the caller.
+    """
+    tp = None
+    if tp_ncomm > 0:
+        if not (tp_mc_ptr and tp_pads_ptr):
+            raise RuntimeError(
+                "fused TP launch requires both a multicast pointer and a "
+                "barrier pad pointer"
+            )
+        tp = (
+            tp_mc_ptr,
+            tp_pads_ptr,
+            tp_seqctr_ptr,
+            tp_rank,
+            tp_world,
+            tp_nchunk,
+            tp_ncomm,
+        )
+    _moe_monokernel_prefill_impl(
+        activations_in,
+        router_logits,
+        expert_weights_up,
+        expert_scales_up,
+        expert_weights_down,
+        expert_scales_down,
+        top_k,
+        renormalize,
+        e_score_correction_bias,
+        out,
+        tp,
+        tp_residual,
+        tp_out_scale,
+    )
+
+
+def moe_monokernel_prefill_out_fake(
+    activations_in: torch.Tensor,
+    router_logits: torch.Tensor,
+    expert_weights_up: torch.Tensor,
+    expert_scales_up: torch.Tensor,
+    expert_weights_down: torch.Tensor,
+    expert_scales_down: torch.Tensor,
+    out: torch.Tensor,
+    top_k: int = 8,
+    renormalize: bool = True,
+    e_score_correction_bias: torch.Tensor | None = None,
+    tp_mc_ptr: int = 0,
+    tp_pads_ptr: int = 0,
+    tp_seqctr_ptr: int = 0,
+    tp_rank: int = 0,
+    tp_world: int = 1,
+    tp_nchunk: int = 0,
+    tp_ncomm: int = 0,
+    tp_residual: torch.Tensor | None = None,
+    tp_out_scale: float = 1.0,
+) -> None:
+    # Nothing to allocate and nothing to return: the destination is an input and
+    # the only effect the compiler needs to know about is that it was written.
+    return None
+
+
+def moe_monokernel_prefill_fake(
+    activations_in: torch.Tensor,
+    router_logits: torch.Tensor,
+    expert_weights_up: torch.Tensor,
+    expert_scales_up: torch.Tensor,
+    expert_weights_down: torch.Tensor,
+    expert_scales_down: torch.Tensor,
+    top_k: int = 8,
+    renormalize: bool = True,
+    e_score_correction_bias: torch.Tensor | None = None,
+    expert_map: torch.Tensor | None = None,
+) -> torch.Tensor:
+    M = activations_in.size(0)
+    H = expert_weights_down.size(1)
+    return torch.empty((M, H), dtype=torch.bfloat16, device=activations_in.device)
+
+
+# direct_register_custom_op lives in vllm.utils.torch_utils and is not imported
+# at the top of this module upstream, so it is pulled in here at the point of use.
+from vllm.utils.torch_utils import (  # noqa: E402
+    direct_register_custom_op as _direct_register_custom_op,
+)
+
+_direct_register_custom_op(
+    op_name="moe_monokernel_prefill",
+    op_func=moe_monokernel_prefill,
+    mutates_args=[],
+    fake_impl=moe_monokernel_prefill_fake,
+)
+
+# The mutating variant. mutates_args=("out",) is the whole point: it is what
+# tells the compiler the op writes a tensor it was handed, so two calls that
+# share a destination are ordered by that tensor and neither can be dropped or
+# hoisted past the other. Registering the fused path as functional and relying
+# on stream order to keep the reuse honest would have been an undocumented
+# assumption, which is exactly what this avoids.
+_direct_register_custom_op(
+    op_name="moe_monokernel_prefill_out",
+    op_func=moe_monokernel_prefill_out,
+    mutates_args=("out",),
+    fake_impl=moe_monokernel_prefill_out_fake,
+)
