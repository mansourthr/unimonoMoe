+    rows = pid * BR + tl.arange(0, BR)
+    c = tl.arange(0, FULL)
+    m = rows[:, None] < n
+    ids = tl.load(ids_ptr + rows[:, None] * FULL + c[None, :], mask=m, other=-1)
+    cnt = tl.sum((ids != -1).to(tl.int32), axis=1)
+    tl.atomic_max(out_ptr, tl.max(cnt, axis=0))
+    tl.atomic_add(out_ptr + 1, tl.sum(cnt, axis=0))
